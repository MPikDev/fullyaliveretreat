# Copy to .env and fill in. Never commit .env.

# --- Required in production -------------------------------------------------

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# The secret path PayPal posts IPN notifications to (no slashes).
# Must match the Notification URL configured in the PayPal account.
PAYPAL_ENDPOINT=

# Gmail app password for fullyaliveretreat@gmail.com (16 chars, no spaces).
# Created at https://myaccount.google.com/apppasswords
# Replaces the old FAR_EMAIL_PASSWORD / FAR_EMAIL_PASS_CODE pair.
FAR_EMAIL_APP_PASSWORD=

# --- Optional ---------------------------------------------------------------

# Never enable in production.
DJANGO_DEBUG=false

# Comma-separated. Defaults to the production domain when unset.
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Path the Django admin is served from, without slashes. Default: admin
DJANGO_ADMIN_URL=

# Postgres connection string. Falls back to local SQLite when unset.
DATABASE_URL=

# Where 500-error reports are emailed. Comma-separated.
DJANGO_ADMIN_EMAILS=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Analytics is omitted when unset.
GA_MEASUREMENT_ID=

# Use the PayPal sandbox instead of live payments. Defaults to the value of DJANGO_DEBUG.
PAYPAL_TEST=
PAYPAL_RECEIVER_EMAIL=

# Failed logins before an IP/username pair is locked out for an hour.
AXES_FAILURE_LIMIT=5

DJANGO_LOG_LEVEL=INFO
